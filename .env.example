# ==============================================================================
# OnTime Environment Configuration Template (.env.example)
# Copy this file to .env.local and populate with your own values.
# DO NOT commit real secrets or credentials to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Gemini API Configuration
# ------------------------------------------------------------------------------
# GEMINI_API_KEY: Your Google Gemini API key from Google AI Studio.
# Optional when LLM_MODE=mock.
GEMINI_API_KEY=your_gemini_api_key_here

# GEMINI_MODEL: The Gemini model name to use for extraction & agent reasoning.
# Allowed values: gemini-3.8-flash, gemini-2.5-flash
GEMINI_MODEL=gemini-3.8-flash

# LLM_MODE: Operating mode for LLM extraction and agent actions.
# Allowed values:
#   - live: Call the real Gemini API using GEMINI_API_KEY.
#   - mock: Return deterministic canned mock responses for offline testing/demo.
LLM_MODE=mock

# LLM_CACHE: Cache Gemini prompt responses in SQLite to save quota/tokens.
# Allowed values: true, false
LLM_CACHE=true

# ------------------------------------------------------------------------------
# PayPal API Configuration
# ------------------------------------------------------------------------------
# PAYPAL_MODE: Provider implementation for invoice creation and payment reminders.
# Allowed values:
#   - sandbox: Execute live requests against PayPal Sandbox REST API (api-m.sandbox.paypal.com).
#   - mock: Use the in-memory MockPayPal provider for offline testing/demo.
PAYPAL_MODE=mock

# PAYPAL_CLIENT_ID: Client ID from your PayPal Developer Dashboard REST App.
# Required when PAYPAL_MODE=sandbox.
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id

# PAYPAL_SECRET: Secret key from your PayPal Developer Dashboard REST App.
# Required when PAYPAL_MODE=sandbox.
PAYPAL_SECRET=your_paypal_sandbox_secret

# PAYPAL_TEST_CLIENT_EMAIL: Target sandbox buyer email for recipient notifications.
# Example: personal buyer account from developer.paypal.com/dashboard/accounts
PAYPAL_TEST_CLIENT_EMAIL=sb-buyer@example.com

# PAYPAL_MERCHANT_EMAIL: Sandbox business account email acting as the merchant invoicer.
# Example: business facilitator account from developer.paypal.com/dashboard/accounts
PAYPAL_MERCHANT_EMAIL=sb-merchant@example.com

